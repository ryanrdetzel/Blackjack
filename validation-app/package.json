{
  "name": "durableagents-validation-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:acceptance": "node --test qualification/acceptance/repair.test.js",
    "test:feature": "node --test qualification/acceptance/feature.test.js",
    "fixture:apply": "node qualification/repair-fixture.js apply",
    "fixture:restore": "node qualification/repair-fixture.js restore"
  },
  "dependencies": { "pg": "8.16.3" }
}
